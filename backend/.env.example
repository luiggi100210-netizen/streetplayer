# ============================================================
# STREETPLAYER — Variables de entorno Backend
# Copia este archivo a .env y completa los valores.
# ============================================================

# Servidor
PORT=4000
NODE_ENV=development
TZ=America/Lima

# Base de datos PostgreSQL (requerida)
DATABASE_URL=postgresql://usuario:password@localhost:5432/streetplayer

# JWT (requerida) — mínimo 32 caracteres aleatorios
JWT_SECRET=cambia_esto_por_un_secreto_largo
# Duración del access token (default: 15m) y del token de admin (default: 8h)
# ACCESS_TOKEN_EXPIRES=15m
# ADMIN_TOKEN_EXPIRES=8h

# CORS — separar con comas sin espacios (requerida en producción)
ALLOWED_ORIGINS=http://localhost:5173

# Admin — se crea/actualiza automáticamente al arrancar
# (ADMIN_PASSWORD es requerida en producción)
ADMIN_EMAIL=admin@streetplayer.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia_esto_por_una_password_segura

# Firebase Admin — login con Google/Facebook
# Consola Firebase → Configuración → Cuentas de servicio → Generar clave
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# SMTP — emails de recuperación de contraseña
# Sin configurar, los emails se imprimen en consola (solo desarrollo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cloudinary — fotos de perfil y eventos
# Sin configurar, las fotos van a disco local (solo desarrollo;
# en Render el disco es efímero y se pierden en cada deploy)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
